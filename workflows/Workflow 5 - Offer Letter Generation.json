    {
      "parameters": {
        "jsCode": "const name = $input.first().json.candidateName;\nconst position = $input.first().json.position;\nconst candidateId = $input.first().json.candidateId;\n\nconst date = new Date().toLocaleDateString(\"en-IN\", {\n  day: \"2-digit\",\n  month: \"long\",\n  year: \"numeric\"\n});\n\nconst joiningDate = new Date();\njoiningDate.setDate(joiningDate.getDate() + 15);\n\nconst joining = joiningDate.toLocaleDateString(\"en-IN\", {\n  day: \"2-digit\",\n  month: \"long\",\n  year: \"numeric\"\n});\n\nconst html = `\n<html>\n<body>\n\n<h2 style=\"text-align:center;\">\nABC Technologies Pvt. Ltd.\n</h2>\n\n<hr>\n\n<p>Date: ${date}</p>\n\n<h3>Offer Letter</h3>\n\n<p>Dear <b>${name}</b>,</p>\n\n<p>Congratulations!</p>\n\n<p>\nWe are pleased to offer you the position of\n<b>${position}</b> at ABC Technologies Pvt. Ltd.\n</p>\n\n<p>\nBased on your interview performance and evaluation,\nwe are delighted to welcome you to our organization.\n</p>\n\n<h3>Employment Details</h3>\n\n<table border=\"1\" cellpadding=\"8\">\n\n<tr>\n<td>Candidate ID</td>\n<td>${candidateId}</td>\n</tr>\n\n<tr>\n<td>Name</td>\n<td>${name}</td>\n</tr>\n\n<tr>\n<td>Position</td>\n<td>${position}</td>\n</tr>\n\n<tr>\n<td>Joining Date</td>\n<td>${joining}</td>\n</tr>\n\n<tr>\n<td>Employment Type</td>\n<td>Full-Time</td>\n</tr>\n\n</table>\n\n<br>\n\n<p>Please confirm your acceptance within 7 days.</p>\n\n<p>We look forward to having you in our team.</p>\n\n<br>\n\n<p>\nRegards,<br>\n<b>HR Department</b><br>\nABC Technologies Pvt. Ltd.\n</p>\n\n</body>\n</html>\n`;\n\nreturn [\n  {\n    json: {\n      html,\n      fileName: `Offer Letter - ${name}.pdf`\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
